{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] TraceId={TraceId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=quotes.db"
  },

  "Jwt": {
    "Issuer": "QuotesApi",
    "Audience": "QuotesApiClients",
    "AccessTokenLifetime": "00:15:00"
  },

  "Entra": {
    "TenantId": "f774bb68-0575-4cd2-9d4c-3b4e593d1110",
    "ClientId": "47f5632f-7592-4f54-b328-cf7b71139f4a",
    "Audience": "api://47f5632f-7592-4f54-b328-cf7b71139f4a"
  }
}